@article{joshi_urban_2016,
	title = {Urban voting and party choices in {Delhi} matching electoral data with property category},
	volume = {51},
	issn = {00129976},
	abstract = {In most parts of the world there is a direct relation between economic and social well-being and political participation. India, though, is among the exceptions to this tendency. The poor in India vote more than the rich. This paper, using the case of Delhi, shows that neighbourhoods have a significant influence in voting patterns. The rich in poor neighbourhoods vote more than the rich in affluent neighbourhoods and the poor in rich neighbourhoods vote less than the poor in underprivileged neighbourhoods. This paper uses property tax and property categories to arrive at Delhi's wealth parameters and then tries to match them with voting patterns.},
	number = {5},
