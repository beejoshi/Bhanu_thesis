@book{cox_making_1997,
	title = {Making {Votes} {Count}},
	abstract = {Popular elections are at the heart of representative democracy. Thus, understanding the laws and practices that govern such elections is essential to understanding modern democracy. In this book, Cox views electoral laws as posing a variety of coordination problems that political forces must solve. Coordination problems - and with them the necessity of negotiating withdrawals, strategic voting, and other species of strategic coordination - arise in all electoral systems. This is the first book that employs a unified game-theoretic model to study strategic coordination worldwide and that relies primarily on constituency-level rather than national aggregate data in testing theoretical propositions about the effects of electoral laws. This is also the first book that considers not just what happens when political forces succeed in solving the coordination problems inherent in the electoral system they face but also what happens when they fail.},
	urldate = {2019-11-29},
	publisher = {Cambridge University Press},
	author = {Cox, Gary W.},
	year = {1997},
	doi = {10.1017/cbo9781139174954},
	note = {Publication Title: Making Votes Count},
}

